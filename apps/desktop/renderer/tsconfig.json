{
  "extends": "../../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "dist-types",
    "tsBuildInfoFile": "dist-types/.tsbuildinfo",
    "emitDeclarationOnly": true,
    "lib": ["es2023", "dom", "dom.iterable"],
    "jsx": "react-jsx",
