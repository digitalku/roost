{
  "name": "@roost/media",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Format probing, decoding, thumbnails, metadata extraction, and content hashing.",
  "license": "UNLICENSED",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./serving": {
      "types": "./dist/serving.d.ts",
      "default": "./dist/serving.js"
    },
    "./document": {
      "types": "./dist/document.d.ts",
      "default": "./dist/document.js"
    },
    "./png": {
      "types": "./dist/png.d.ts",
      "default": "./dist/png.js"
    },
    "./testing/*": {
      "types": "./dist/testing/*.d.ts",
      "default": "./dist/testing/*.js"
    }
  },
  "types": "./dist/index.d.ts",
  "main": "./dist/index.js",
  "dependencies": {
    "@hyzyla/pdfium": "2.1.13",
    "@napi-rs/blake-hash": "1.4.0",
    "@resvg/resvg-wasm": "2.6.2",
    "@roost/core": "workspace:*",
    "fontkit": "2.0.4",
    "sharp": "^0.35.3"
  },
  "devDependencies": {
    "@types/fontkit": "2.0.9",
    "@types/node": "22.20.1"
  }
}
