# Biome formats the code; this is for editors that have not loaded it yet, and
# for the file types Biome does not touch.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 2
max_line_length = 100

[*.md]
trim_trailing_whitespace = false

[*.sql]
indent_size = 2
