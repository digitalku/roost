{
  "name": "roost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first digital asset manager",
  "license": "MIT",
  "author": "Digitalku",
  "homepage": "https://roost.digitalku.com",
  "bugs": {
    "email": "roostsupport@digitalku.com"
  },
  "repository": {
    "type": "git",
    "url": "git+ssh://git@github.com/digitalku/roost.git"
  },
  "engines": {
    "node": ">=22.11"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "postinstall": "node scripts/build-sharp.mjs",
    "build": "tsc -b",
    "build:native": "node scripts/build-sharp.mjs",
    "typecheck": "tsc -b --force",
    "clean": "tsc -b --clean",
    "check": "biome check --write",
    "check:ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:css": "node scripts/check-css-tokens.mjs \"apps/desktop/renderer/**/*.css\"",
    "verify": "pnpm typecheck && pnpm check:ci && pnpm check:css && pnpm test",
    "dev": "pnpm build && node scripts/dev.mjs",
    "start": "pnpm build && pnpm --filter @roost/desktop-renderer build && node scripts/start.mjs",
    "refresh": "node scripts/refresh.mjs"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@roost/core": "workspace:*",
    "@roost/library": "workspace:*",
    "@roost/media": "workspace:*",
    "@types/node": "22.20.1",
    "electron": "43.4.1",
    "node-addon-api": "^8.9.2",
    "node-gyp": "^13.0.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
