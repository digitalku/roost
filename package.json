{
  "name": "roost",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "A local-first digital asset manager",
  "license": "MIT",
  "engines": {
    "node": ">=22.11"
  },
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "clean": "tsc -b --clean",
    "check": "biome check --write",
    "check:ci": "biome ci",
    "test": "vitest run",
    "test:watch": "vitest",
    "check:css": "node scripts/check-css-tokens.mjs 'apps/desktop/renderer/**/*.css'",
    "verify": "pnpm typecheck && pnpm check:ci && pnpm check:css && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.10",
    "@roost/core": "workspace:*",
    "@roost/library": "workspace:*",
    "@types/node": "22.20.1",
    "electron": "43.4.1",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
